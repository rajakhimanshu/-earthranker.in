rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Leaderboard rules
    match /leaderboard/{entryId} {
      
      // Anyone can read the global leaderboard
      allow read: if true;
      
      // Allow creation of new entries with basic validation
      allow create: if 
        request.resource.data.keys().hasAll(['score', 'displayName', 'tier', 'timestamp']) &&
        request.resource.data.keys().hasOnly([
          'id', 'displayName', 'score', 'tier', 'oneIn', 'country', 
          'topSkills', 'allSkills', 'timestamp', 'birthDay', 'birthMonth', 
          'education', 'bloodType', 'eyeColor', 'hairColor', 'handedness', 
          'nameInitial', 'aiStory'
        ]) &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 100 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 50 &&
        request.resource.data.timestamp == request.time;

      // No one can update or delete entries
      allow update, delete: if false;
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
